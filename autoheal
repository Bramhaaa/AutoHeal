#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_DIR="$ROOT_DIR/.autoheal-dev"
BACKEND_PID_FILE="$DEV_DIR/backend.pid"
FRONTEND_PID_FILE="$DEV_DIR/frontend.pid"
BACKEND_LOG="$DEV_DIR/backend.log"
FRONTEND_LOG="$DEV_DIR/frontend.log"
LOCAL_DEMO_REPO="/tmp/autoheal-demo-service"

mkdir -p "$DEV_DIR"

load_env() {
  if [[ -f "$ROOT_DIR/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$ROOT_DIR/.env"
    set +a
  fi
}

pick_postgres_port() {
  if [[ -n "${POSTGRES_PORT:-}" ]]; then
    echo "$POSTGRES_PORT"
    return
  fi
  # If autoheal-postgres is already running, reuse its published port
  local existing
  existing="$(docker port autoheal-postgres 5432 2>/dev/null | head -n 1 | awk -F: '{print $NF}' || true)"
  if [[ -n "$existing" ]]; then
    echo "$existing"
    return
  fi
  # Avoid colliding with another Postgres already bound to 5432
  if lsof -nP -iTCP:5432 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "5433"
  else
    echo "5432"
  fi
}

is_pid_running() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

stop_process() {
  local name="$1"
  local pid_file="$2"
  local port="$3"

  if [[ -f "$pid_file" ]]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    if is_pid_running "$pid"; then
      echo "Stopping $name (PID $pid)..."
      kill "$pid" 2>/dev/null || true
      sleep 1
      if is_pid_running "$pid"; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$pid_file"
  fi

  # Also clean up any listener still holding the dev port (e.g. Maven child JVM)
  local port_pids
  port_pids="$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "$port_pids" ]]; then
    echo "Stopping $name listener on port $port..."
    # shellcheck disable=SC2086
    kill $port_pids 2>/dev/null || true
    sleep 1
    port_pids="$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "$port_pids" ]]; then
      # shellcheck disable=SC2086
      kill -9 $port_pids 2>/dev/null || true
    fi
  fi
}

wait_for_url() {
  local label="$1"
  local url="$2"
  local max_seconds="$3"
  local i
  for ((i = 1; i <= max_seconds; i++)); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      echo "  ✓ $label is ready ($url)"
      return 0
    fi
    sleep 1
  done
  echo "  ✗ $label did not become ready within ${max_seconds}s. Check logs with: ./autoheal logs"
  return 1
}

cmd_up() {
  if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker Desktop is not running. Start Docker Desktop first."
    exit 1
  fi

  load_env

  # 1. Sandbox image (one-time)
  if ! docker image inspect autoheal-maven-runner:java21 >/dev/null 2>&1; then
    echo "[1/4] Building autoheal-maven-runner:java21 sandbox image (one-time)..."
    docker build -t autoheal-maven-runner:java21 -f "$ROOT_DIR/sandbox/Dockerfile" "$ROOT_DIR"
  else
    echo "[1/4] Sandbox image autoheal-maven-runner:java21 already present."
  fi

  # 2. Local demo repo (only needed if DEMO_REPO_URI points to it or is unset)
  local demo_uri="${DEMO_REPO_URI:-file://$LOCAL_DEMO_REPO}"
  if [[ "$demo_uri" == "file://$LOCAL_DEMO_REPO" && ! -d "$LOCAL_DEMO_REPO/.git" ]]; then
    echo "[2/4] Generating local demo repo at $LOCAL_DEMO_REPO..."
    "$ROOT_DIR/demo-service/scripts/create-scenario-branches.sh" "$LOCAL_DEMO_REPO" >/dev/null
  else
    echo "[2/4] Demo repo ready ($demo_uri)."
  fi

  # 3. PostgreSQL + pgvector
  local pg_port
  pg_port="$(pick_postgres_port)"
  echo "[3/4] Starting PostgreSQL (pgvector:pg16) on port $pg_port..."
  POSTGRES_PORT="$pg_port" docker compose -f "$ROOT_DIR/docker-compose.yml" up -d >/dev/null

  # 4. Backend & Frontend
  echo "[4/4] Starting Backend (:8080) and Frontend (:3000)..."

  if lsof -t -iTCP:8080 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "  • Backend already listening on :8080"
  else
    (
      cd "$ROOT_DIR/backend"
      DATABASE_URL="jdbc:postgresql://localhost:${pg_port}/autoheal" \
      DEMO_REPO_URI="$demo_uri" \
      FRONTEND_ORIGIN="${FRONTEND_ORIGIN:-http://localhost:3000}" \
      nohup mvn spring-boot:run >"$BACKEND_LOG" 2>&1 &
      echo $! >"$BACKEND_PID_FILE"
    )
  fi

  if lsof -t -iTCP:3000 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "  • Frontend already listening on :3000"
  else
    if [[ ! -d "$ROOT_DIR/frontend/node_modules" ]]; then
      echo "  • Installing frontend dependencies (npm ci)..."
      (cd "$ROOT_DIR/frontend" && npm ci >/dev/null)
    fi
    (
      cd "$ROOT_DIR/frontend"
      nohup npm run dev >"$FRONTEND_LOG" 2>&1 &
      echo $! >"$FRONTEND_PID_FILE"
    )
  fi

  wait_for_url "Backend" "http://localhost:8080/actuator/health" 45
  wait_for_url "Frontend" "http://localhost:3000" 30

  echo ""
  echo "AutoHeal is running!"
  echo "  Playground UI : http://localhost:3000"
  echo "  Backend API   : http://localhost:8080"
  echo "  Postgres      : localhost:${pg_port}/autoheal"
  echo "  Logs          : ./autoheal logs"
  echo "  Stop all      : ./autoheal down"
}

cmd_down() {
  stop_process "Frontend" "$FRONTEND_PID_FILE" 3000
  stop_process "Backend" "$BACKEND_PID_FILE" 8080
  echo "Stopping PostgreSQL container (keeping data volume)..."
  docker compose -f "$ROOT_DIR/docker-compose.yml" down >/dev/null 2>&1 || true
  echo "All AutoHeal services stopped."
}

cmd_status() {
  echo "=== AutoHeal Status ==="
  if docker ps --format '{{.Names}} ({{.Status}})' | grep -q '^autoheal-postgres'; then
    echo "  Postgres : UP — $(docker ps --format '{{.Names}} {{.Ports}} ({{.Status}})' | grep '^autoheal-postgres')"
  else
    echo "  Postgres : DOWN"
  fi
  if curl -fsS http://localhost:8080/actuator/health >/dev/null 2>&1; then
    echo "  Backend  : UP — http://localhost:8080"
  else
    echo "  Backend  : DOWN"
  fi
  if curl -fsS http://localhost:3000 >/dev/null 2>&1; then
    echo "  Frontend : UP — http://localhost:3000"
  else
    echo "  Frontend : DOWN"
  fi
}

cmd_logs() {
  local target="${1:-all}"
  case "$target" in
    backend)  tail -f "$BACKEND_LOG" ;;
    frontend) tail -f "$FRONTEND_LOG" ;;
    all)      tail -f "$BACKEND_LOG" "$FRONTEND_LOG" ;;
    *)        echo "Usage: ./autoheal logs [backend|frontend|all]"; exit 1 ;;
  esac
}

case "${1:-}" in
  up)      cmd_up ;;
  down)    cmd_down ;;
  restart) cmd_down && cmd_up ;;
  status)  cmd_status ;;
  logs)    cmd_logs "${2:-all}" ;;
  *)
    echo "Usage: ./autoheal <up|down|restart|status|logs [backend|frontend]>"
    exit 1
    ;;
esac
